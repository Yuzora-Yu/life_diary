{
  "services": [{"binding":"YU_ZORA_ERROR_PAGES","service":"yu-zora-main"}],
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yu-zora-life-diary",
  "account_id": "7e10da8ec857bed20f4b1010952279dd",
  "main": "worker/shared-404/index.mjs",
  "compatibility_date": "2026-11-02",
  "workers_dev": false,
  "preview_urls": false,
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "yu-zora.com/tools/life_diary", "zone_name": "yu-zora.com" },
    { "pattern": "yu-zora.com/tools/life_diary/*", "zone_name": "yu-zora.com" }
  ],
  "observability": { "enabled": true }
}
